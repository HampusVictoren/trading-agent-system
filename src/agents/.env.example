# Every variable is prefixed TAS_. Without it, OPENAI_API_KEY - which openai's own SDK
# reads, and which you may well have in your shell for another project - would silently
# become this service's key, because a shell value beats this file.
#
# Nothing has a default. An incomplete environment stops the service at startup rather
# than falling back to a cloud API, the wrong database role or a model nobody chose.

# Legacy full-access API key (grants every scope). Generate with
# `python -c "import secrets; print(secrets.token_urlsafe(32))"` and give the engine the
# same value: `dotnet user-secrets set "AgentService:ApiKey" "<key>" --project src/engine`.
# Deprecated for new deployments once scoped keys below are in use on both sides.
TAS_AGENT_API_KEY=generate_your_own

# Optional single-scope keys. When set, each grants only that scope. A market-only key
# cannot spend LLM time; an outcomes key cannot trigger screening. Leave unset to rely
# on the legacy key alone during the transition.
# TAS_AGENT_API_KEY_SIGNALS=generate_your_own
# TAS_AGENT_API_KEY_SCREEN=generate_your_own
# TAS_AGENT_API_KEY_OUTCOMES=generate_your_own
# TAS_AGENT_API_KEY_MARKET=generate_your_own

# HMAC secret for POST /v1/outcomes (separate from the API key). The engine signs
# the raw body; unsigned or mismatched requests are refused. Same generation as above,
# then: dotnet user-secrets set "AgentService:OutcomesHmacSecret" "<secret>" --project src/engine
TAS_OUTCOMES_HMAC_SECRET=generate_your_own

# OpenAPI/Swagger (/docs, /redoc, /openapi.json). Off by default - these routes sit
# outside the API key. Set to true only on a developer's own loopback.
TAS_ENABLE_DOCS=false

# Connects as agent_svc, which can reach the agent schema and nothing else.
# The password is AGENT_DB_PASSWORD from the .env in the repo root.
TAS_DATABASE_URL=postgresql://agent_svc:CHANGE_ME@127.0.0.1:5432/tradingdb

# Embeddings. The model is pinned in memory.py, because nomic-embed-text's 768 dimensions
# are the column width - changing it means changing the schema. Named for the job rather
# than for Ollama, so the name still fits if the endpoint moves.
# Use explicit IPv4: localhost can resolve to ::1 and time out.
TAS_EMBEDDINGS_BASE_URL=http://127.0.0.1:11434/v1
TAS_EMBEDDINGS_API_KEY=any_placeholder_while_this_is_ollama

# Market data. The timeout bounds one yfinance call, which is synchronous network I/O run
# in a thread; the TTL is how long a quote may be reused before it is fetched again.
TAS_MARKET_DATA_TIMEOUT_S=30
TAS_MARKET_DATA_TTL_S=300

# Screening. Its own pair, because the calls are not comparable: one quote for one instrument
# against six months of bars for up to a hundred. The TTL is long because the factors are
# built from daily bars - a universe does not change again until tomorrow's close.
TAS_SCREEN_TIMEOUT_S=120
TAS_SCREEN_TTL_S=3600

# The team's default model. One of: openai_compatible, openai, anthropic, ollama, xai.
# openai_compatible is anything speaking OpenAI's wire format at a base URL of its own -
# Ollama's /v1, Grok's /v1, LM Studio - and it is what this project runs on.
TAS_LLM__DEFAULT__PROVIDER=openai_compatible
TAS_LLM__DEFAULT__MODEL=qwen2.5:14b
TAS_LLM__DEFAULT__BASE_URL=http://127.0.0.1:11434/v1
TAS_LLM__DEFAULT__API_KEY=any_placeholder_while_this_is_ollama
# Explicit rather than defaulted: it changes what the model answers, and stage 4 compares
# outcomes across runs, so it may not be an uncontrolled variable. 0.0 rather than 0.2,
# because finding G showed the team giving BUY, HOLD and SELL on one fact sheet and a
# sampled answer cannot be told apart from an unstable one. Greedy decoding removes the
# draw, so a contradiction that survives is the model's, not the dice's.
TAS_LLM__DEFAULT__TEMPERATURE=0.0
# Caps one LLM call. The openai client otherwise waits 600 s to read a response, which
# would make a 504 unreachable in practice. 60 rather than 30: a 14B model answers a step
# in 8-9 s warm and about 16 s cold, so 30 left no room for a longer fact sheet.
TAS_LLM__DEFAULT__TIMEOUT_S=60
# Belt and braces beside temperature 0, and part of team_version, so a run's identity
# records it. Note what it does not buy: Ollama's output is byte-identical when the same
# request is repeated in the same state, but a different request in between changes the
# bytes, because the numerics depend on batching and KV-cache state outside the request.
# Reproducibility here is "the same answer", not "the same run".
#
# Only where the provider supports it - everything except anthropic, which has no seed
# field at all. Switching the default provider to anthropic therefore means removing this
# line as well; settings.py refuses the combination at startup rather than dropping it
# silently, because a dropped seed looks like reproducibility.
TAS_LLM__DEFAULT__SEED=42

# Optional: override the model for one step of the team. The role names are the steps'
# own - market_analyst, risk_manager, portfolio_manager - and startup refuses a name no
# step uses, so a typo cannot quietly fall back to the default above.
# TAS_LLM__ROLES__PORTFOLIO_MANAGER__PROVIDER=anthropic
# TAS_LLM__ROLES__PORTFOLIO_MANAGER__MODEL=claude-opus-5
# TAS_LLM__ROLES__PORTFOLIO_MANAGER__API_KEY=sk-ant-...
# TAS_LLM__ROLES__PORTFOLIO_MANAGER__TEMPERATURE=0.2
# TAS_LLM__ROLES__PORTFOLIO_MANAGER__TIMEOUT_S=60

# Rate limits for costly endpoints (requests per rolling minute). Per-key stops one
# stolen credential; global stops a flood even if several keys are in play.
TAS_RATE_LIMIT_SIGNALS_PER_MINUTE=10
TAS_RATE_LIMIT_SIGNALS_GLOBAL_PER_MINUTE=30
TAS_RATE_LIMIT_SCREEN_PER_MINUTE=30
TAS_RATE_LIMIT_SCREEN_GLOBAL_PER_MINUTE=60

# The socket `python -m app` binds. When uvicorn is started by hand instead, these are a
# policy hint that must match its --host and --port. Either way, a non-loopback bind warns
# at startup unless TAS_ENVIRONMENT is development.
TAS_BIND_HOST=127.0.0.1
TAS_PORT=8000
TAS_ENVIRONMENT=development

# When true, /ready includes dependency names (database/llm). Default false keeps the
# public probe to a status string; detail remains in server logs.
TAS_READY_DETAIL=false
