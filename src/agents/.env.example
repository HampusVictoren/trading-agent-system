# What the engine must present as X-Api-Key to start an analysis. Generate one with
# `python -c "import secrets; print(secrets.token_urlsafe(32))"` and give the engine the
# same value: `dotnet user-secrets set "AgentService:ApiKey" "<key>" --project src/engine`.
AGENT_API_KEY=generate_your_own

# Only needed for real OpenAI; any placeholder works when LLM_BASE_URL points at Ollama.
OPENAI_API_KEY=your_openai_api_key_here

# Connects as agent_svc, which can reach the agent schema and nothing else.
# The password is AGENT_DB_PASSWORD from the .env in the repo root.
DATABASE_URL=postgresql://agent_svc:CHANGE_ME@127.0.0.1:5432/tradingdb

# Ollama runs locally. Use explicit IPv4: localhost can resolve to ::1 and time out.
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_MODEL=llama3.2

# Caps one LLM call. The openai client otherwise waits 600 s to read a response, which
# would make a 504 unreachable in practice. The engine's own attempt timeout is tighter.
LLM_TIMEOUT_SECONDS=30
