{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "AgentService": {
    "BaseUrl": "http://127.0.0.1:8000",
    // One whole /v1/signals call, per attempt. A cycle is three LLM steps, and a 14B model
    // answers one in 8-9 s warm and about 16 s cold, so 30 sat right on the edge. 120 is a
    // ceiling rather than an expectation: the agent service caps each step at 60 s, so a
    // chain where every step ran to its limit would take 180 s and the engine gives up on
    // it first, which is the right way round.
    "RequestTimeoutSeconds": 120
  },
  "RiskPolicy": {
    "MaxPositionPercentage": 0.05,
    "CashBufferPct": 0.10,
    "MaxQuoteAgeSeconds": 300,
    // Three days before the agents may sell what they just bought. A cycle runs about once a
    // minute, and the same model given the same fact sheet answered HOLD at 0.50 and then BUY
    // at 0.60 two minutes later - so at zero, one instrument could be traded several times an
    // afternoon on noise, and the commission on every leg would be the only certain result.
    // The stop-loss and the time limit are exempt, so this slows down changes of mind and not
    // risk controls. Three rather than more because the shortest horizon a thesis may ask for
    // is a day: a longer wait would routinely outlive the thesis it was protecting.
    "MinHoldingPeriodDays": 3,
    // Ten percent below what a holding cost and the engine sells it without asking. Set against
    // how much these instruments move rather than against a feeling about losses: Swedish large
    // caps run at roughly 25-30 % annualised volatility, about 1.8 % a day, so a two-sigma week
    // is an eight percent move. A tighter stop would mostly sell noise; a looser one would not
    // be a stop. Measured against the average purchase price, not a high-water mark the
    // position does not keep.
    "StopLossPercentage": 0.10,
    // Twenty percent of the portfolio in purchases a trading day, which is four positions at the
    // full conviction tier or eight at the half tier. It is not about any one position being too
    // big - MaxPositionPercentage is that rule - it is about correlation in time. The engine
    // screens once a day and analyses each instrument once, so a day's buying is ten decisions
    // from one model within a few minutes, sharing whatever that day's bias is; and a momentum
    // ranking in a rising market hands it ten names that move together, so "spread over ten
    // positions" is weaker than it looks. The first real screened cycle deployed ten percent, so
    // this leaves room for a normal day and stops a single one putting out half the account. The
    // cost is that it slows the portfolio's formation, and therefore the baseline.
    "MaxDailyDeploymentPercentage": 0.20
  },
  "Outcome": {
    "CommissionBps": 1,
    "SpreadBps": 2,
    "HoldBandPct": 0.02,
    // The fund tracking OMXS30, in SEK, so a hit is measured against the market the
    // instruments actually trade in. Not ^OMX, which would be the index itself and the purer
    // comparison: a leading ^ is not something a tradeable instrument has, and the symbol
    // rule is shared with the instruments the engine can own. The fund's management fee is
    // about 0.008 % over twenty trading days, two orders of magnitude below the 3 bps of
    // commission and spread already subtracted.
    "BenchmarkSymbol": "XACT-OMXS30.ST",
    "FixedHorizonTradingDays": [ 1, 5, 20 ],
    "SweepIntervalHours": 24
  },
  "Trading": {
    // OMXS30, which is the market the account is denominated in and the market the benchmark
    // tracks - so a hit against XACT-OMXS30.ST is measured against the index the candidates
    // were drawn from rather than against a different market. The benchmark itself is
    // deliberately absent: it is a fund, and funds are a deliberate no.
    //
    // Thirty-one names, well inside the contract's cap of a hundred. A symbol that has gone
    // stale does not break a cycle - it comes back in the screen's rejections with the reason,
    // which is the only way a universe that is quietly rotting ever becomes visible.
    "Universe": [
      "ABB.ST",
      "ALFA.ST",
      "ASSA-B.ST",
      "ATCO-A.ST",
      "ATCO-B.ST",
      "AZN.ST",
      "BOL.ST",
      "ELUX-B.ST",
      "EQT.ST",
      "ERIC-B.ST",
      "ESSITY-B.ST",
      "EVO.ST",
      "GETI-B.ST",
      "HEXA-B.ST",
      "HM-B.ST",
      "INDU-C.ST",
      "INVE-B.ST",
      "KINV-B.ST",
      "NDA-SE.ST",
      "NIBE-B.ST",
      "SAAB-B.ST",
      "SAND.ST",
      "SCA-B.ST",
      "SEB-A.ST",
      "SHB-A.ST",
      "SINCH.ST",
      "SKF-B.ST",
      "SWED-A.ST",
      "TEL2-B.ST",
      "TELIA.ST",
      "VOLV-B.ST"
    ],
    // Ten instruments per cycle. Each one costs three LLM calls at 8-9 s, so a full shortlist
    // is a few minutes of wall clock - which is the number this setting is really about. It is
    // also roughly a third of the universe, enough that the ranking is doing real selecting.
    "ShortlistSize": 10,
    // Ten million kronor of typical daily turnover. Every name above clears it by two orders
    // of magnitude, which is the point: at this account size an order is a few thousand kronor
    // and liquidity is never the binding constraint, so the floor is a guard against a symbol
    // whose data has gone stale rather than against a share that is hard to buy.
    "MinDollarVolume": 10000000,
    // Fifteen minutes, and it is the exits this number is for. The analyses are paced by the
    // trading day now - one screen and at most one analysis per instrument per day - so a
    // shorter interval would only ask "has anything changed?" more often. The exits run every
    // cycle, so this is also the slack in a stop-loss: fifteen minutes of it, against the 1.8 %
    // a day these instruments move.
    "CycleIntervalMinutes": 15,
    "TeamId": "default",
    // In SEK, like everything else. 100 000 rather than the 10 000 it was in dollars, and the
    // reason is the measurement rather than ambition: at 10 000 the 5 % position cap leaves
    // 500 kr, which buys zero shares of Volvo or Investor at the half conviction tier and one
    // at the full tier. Two thirds of the universe would be unbuyable at moderate conviction,
    // and conviction would stop making any difference to size - which is the one thing stage
    // 8's calibration needs it to do. At 100 000 the tiers are 7 shares against 15.
    "OpeningBalance": 100000
  }
}
