# Read by docker-compose.yml, and by nothing else. Copy to .env and fill it in.
#
# Compose reads this file itself, to interpolate ${...} in docker-compose.yml. It is never
# handed to a container: what each service receives is the explicit list under its own
# `environment:`, which is what keeps the agent service from ever seeing the superuser's or
# the engine's password. That separation used to be two files; now it is one file and a
# compose file you can read.

# --- Required: the database roles. One per service, plus the superuser. ---
# Generate each with:  python3 -c "import secrets; print(secrets.token_urlsafe(32))"
POSTGRES_PASSWORD=
ENGINE_DB_PASSWORD=
AGENT_DB_PASSWORD=

# --- Required: shared between the two services, so both sides must have the same value. ---
# The agent service also reads these from src/agents/.env when it is run outside compose
# (as TAS_AGENT_API_KEY and TAS_OUTCOMES_HMAC_SECRET), and the engine from its user secrets
# (AgentService:ApiKey and AgentService:OutcomesHmacSecret). Three places, one value each -
# a mismatch is a 401 the engine reports as "the agent service answered 401".
#
# The HMAC secret is separate from the API key on purpose: a stolen key alone must not be
# enough to forge measurements into agent memory.
AGENT_API_KEY=
OUTCOMES_HMAC_SECRET=

# --- Optional: where the LLM backend is, and which model. ---
# The default reaches Ollama on the host. A container's 127.0.0.1 is the container, so
# host.docker.internal is how it gets out; compose maps that to the host gateway, and WSL's
# mirrored networking has already put the host's localhost on Windows.
#
# **LLM_MODEL is part of team_version.** The hash covers each role's resolved model, so this
# and src/agents/.env must name the same one, or the same team answers under two versions and
# two populations that cannot be pooled accumulate under one name.
# OLLAMA_BASE_URL=http://host.docker.internal:11434/v1
# OLLAMA_API_KEY=ollama-needs-no-key
# LLM_MODEL=qwen2.5:14b

# --- Optional: what the engine does with an approved order. ---
# Shadow records every decision and places nothing; Paper executes against the simulated
# portfolio, which is what the engine did before stage 7. Live is refused at startup, because
# there is no broker. Changing it is a restart; stopping a running engine is the kill switch.
# TRADING_MODE=Shadow

# --- Optional: where the engine sends its metrics and traces, over OTLP. ---
# Unset or empty: nothing is exported, and nothing retries in the background. Inside compose
# this has to be a name the engine container can reach, never localhost. One endpoint takes both
# signals: the per-signal OTEL_EXPORTER_OTLP_TRACES_ENDPOINT and friends are not supported, and
# setting one turns export off with a line in the log saying so. OTEL_SDK_DISABLED=true turns
# export off without unsetting the endpoint.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://collector:4317
# OTEL_SDK_DISABLED=false

# --- Optional: published ports, so a second stack can run beside the first. ---
# That is how docker-compose.yml is tested against a clean volume without touching the one
# holding real decisions: a project name of its own and two ports nobody is using.
# DB_PORT=5432
# AGENTS_PORT=8000
# DB_CONTAINER=trading-db

# --- Optional: declares the environment to the agent service. ---
# Anything but development makes a non-loopback bind log a startup warning - which a
# container always has, deliberately, so leave this alone unless the warning is wanted.
# TAS_ENVIRONMENT=development
