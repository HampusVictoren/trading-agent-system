# Database secrets read by docker-compose.yml. Copy to .env and fill in.
# Generate each value with:  python3 -c "import secrets; print(secrets.token_urlsafe(32))"
#
# Kept separate from src/agents/.env on purpose: the agent service must never
# see the superuser's or the engine's password, or the per-service roles mean nothing.
POSTGRES_PASSWORD=
ENGINE_DB_PASSWORD=
AGENT_DB_PASSWORD=
